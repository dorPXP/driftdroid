<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A window program: on Windows no console opens behind it. The terminal modes attach one. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DriftDroidBuilder</AssemblyName>
    <RootNamespace>DriftDroidBuilder</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.4.0</Version>
    <Product>DriftDroid Builder</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <!-- No PDB, and no build-machine path recorded in the executable. -->
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <!-- The artwork is the Android launcher's own. -->
  <ItemGroup>
    <EmbeddedResource Include="../../../android/app/src/main/res/drawable-xxhdpi/driftdroid_logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="../../../android/app/src/main/res/drawable-xxxhdpi/channel_mkwii.jpg" LogicalName="channel_mkwii.jpg" />
    <EmbeddedResource Include="../../../android/app/src/main/res/drawable-xxxhdpi/channel_retro_rewind.jpg" LogicalName="channel_retro_rewind.jpg" />
    <EmbeddedResource Include="../../../android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png" LogicalName="icon.png" />
    <!-- The Switch menu icon the .nro files get unless the player chooses their own picture. -->
    <EmbeddedResource Include="Assets/switch-icon.jpg" LogicalName="switch-icon.jpg" />
  </ItemGroup>

  <!-- The translations (generated by tools/i18n/gen.py from the shared i18n/*.json). -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/i18n/*.json" LogicalName="i18n/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
