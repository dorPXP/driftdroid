<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for local (LAN) multiplayer and Retro-WFC: the game's own guest-side network
         code (in the recompiled binary) opens real UDP/TCP sockets via runtime/src/hle/net/,
         which silently fails on Android without these. CHANGE_WIFI_MULTICAST_STATE backs the
         MulticastLock acquired in MainActivity, required for the app to actually receive
         broadcast/multicast UDP packets (LAN host discovery) on Wi-Fi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Real Bluetooth controller rumble goes through Vibrator/VibratorManager (SDL's own
         SDLControllerManager.java) - without this permission that call silently no-ops on most
         OEM builds instead of throwing, which is why rumble looked like a code bug at first. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- RetroRewindInstallService runs the ~2GB Retro Rewind copy/extract as a foreground
         service so Android doesn't reclaim the process mid-install when the app is backgrounded
         (see the service's own doc comment). POST_NOTIFICATIONS is best-effort - if denied, the
         install still runs, it just won't show live progress in the notification shade. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.WiiCompiled">

        <!-- The Original/Retro Rewind choice must happen before any product .so loads (Android
             cannot swap which native library is loaded within a process), so it's now the actual
             launcher - MainActivity is started explicitly from here with the resolved choice. -->
        <activity
            android:name=".ModePickerActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">
        </activity>

        <service
            android:name=".RetroRewindInstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
